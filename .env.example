# Local/hosted AI engine. Never commit the real values.
AI_DB_PATH=.sporton/ai.sqlite
AI_MIN_TRAIN_GAMES=40
AI_MIN_TEAM_GAMES=5
AI_EDGE_THRESHOLD=0.04

# Optional 1X2/totals odds from The Odds API (the-odds-api.com). Read only by server/odds.cjs;
# without a key /api/odds returns 503 and the site shows no odds. See docs/ODDS.md for quota.
ODDS_API_KEY=
# Bookmaker keys as named by the provider (max 10).
ODDS_BOOKMAKERS=pinnacle,williamhill,betfair_ex_eu
# Provider cache per date; each refresh costs quota for every priced league with fixtures.
ODDS_CACHE_SECONDS=600

# Existing score server settings.
PORT=4173
ALLOWED_ORIGINS=https://sporton.live
# Reverse proxies/CDNs in front of the score server (0 = direct). Set 1 behind a single
# proxy so the per-visitor rate limit uses X-Forwarded-For instead of the proxy address.
TRUST_PROXY_HOPS=0
