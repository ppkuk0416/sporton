# Local/hosted AI engine. Never commit the real values.
AI_DB_PATH=.sporton/ai.sqlite
AI_MIN_TRAIN_GAMES=40
AI_MIN_TEAM_GAMES=5
AI_EDGE_THRESHOLD=0.04


# Existing score server settings.
PORT=4173
ALLOWED_ORIGINS=https://sporton.live
# Reverse proxies/CDNs in front of the score server (0 = direct). Set 1 behind a single
# proxy so the per-visitor rate limit uses X-Forwarded-For instead of the proxy address.
TRUST_PROXY_HOPS=0
