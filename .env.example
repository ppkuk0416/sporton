# Local/hosted AI engine. Never commit the real values.
AI_DB_PATH=.sporton/ai.sqlite
AI_MIN_TRAIN_GAMES=40
AI_MIN_TEAM_GAMES=5
AI_EDGE_THRESHOLD=0.04

# Optional licensed market feed. The key is read only by the server/CLI.
ODDS_API_KEY=
ODDS_API_REGIONS=us

# Existing score server settings.
PORT=4173
ALLOWED_ORIGINS=https://sporton.live
